# BlockProctor Backend Environment Variables

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/blockproctor

# Server
PORT=8080
NODE_ENV=development

# Blockchain (local Anvil / Foundry node; the docker-compose service name is
# blockproctor-blockchain)
BLOCKCHAIN_RPC=http://127.0.0.1:8545

# Default Hardhat Account #0 Private Key (for local dev only)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Contract Addresses
# In Docker, addresses are resolved automatically from
# /blockchain/artifacts/blockchain-addresses.env (written by the blockchain
# container's auto-deploy step on startup). PROCTOR_CHAIN_ADDRESS here is only
# a fallback for local/standalone runs.
PROCTOR_CHAIN_ADDRESS=

# Shared address file (optional override; default matches the docker-compose volume)
# BLOCKCHAIN_ADDRESS_FILE=/blockchain/artifacts/blockchain-addresses.env

# JWT Secret (REQUIRED - the server fails to start if missing or weak)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
